<script>
    const scroller = document.querySelector(".scroller");

    if (scroller) {
        const textBlocks = Array.from(scroller.querySelectorAll(".scroller-text"));
        const videos = Array.from(scroller.querySelectorAll(".scroller-media video"));
        let scrollFrame = 0;

        const updateActiveVideo = () => {
            scrollFrame = 0;
            const activeIndex = textBlocks.reduce((currentIndex, text, index) => {
                return text.getBoundingClientRect().top <= 0 ? index : currentIndex;
            }, 0);

            videos.forEach((video, index) => {
                video.classList.toggle("is-active", index === activeIndex);
            });
        };

        const requestVideoUpdate = () => {
            if (!scrollFrame) {
                scrollFrame = requestAnimationFrame(updateActiveVideo);
            }
        };

        window.addEventListener("scroll", requestVideoUpdate, { passive: true });
        window.addEventListener("resize", requestVideoUpdate);
        updateActiveVideo();
    }
</script>

<style>
    .scroller {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: repeat(3, minmax(100vh, auto));
        gap: 10vh;
        padding-inline: 8vw;
    }

    .scroller-text {
        grid-column: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .scroller-media {
        grid-column: 2;
        grid-row: 1 / 4;
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        overflow: hidden;
    }

    .scroller-media video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transform: scale(1.03);
        transition: opacity 600ms ease, transform 600ms ease;
    }

    .scroller-media video.is-active {
        opacity: 1;
        transform: scale(1);
    }

    .scroller hr {
        color: var(--color-ocean-accent);
    }

    .scroller h2 {
        width: 100%;
        color: var(--color-ocean-text-blue);
        font-size: 3.5rem;
        font-weight: 600;
        text-align: left;
    }

    @media (prefers-reduced-motion: reduce) {
        .scroller-media video {
            transition: none;
        }
    }
</style>
